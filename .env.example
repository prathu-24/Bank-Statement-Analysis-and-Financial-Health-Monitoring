# ==============================================================================
# FinSight Environment Configuration (.env)
# ==============================================================================

# At-Rest Database Field Encryption (256-bit Fernet Base64 Key)
# Generate a new key using: python scripts/generate_key.py
# If left empty, FinSight operates with volatile in-session memory encryption.
FINSIGHT_ENCRYPTION_KEY=

# Local SQLite Database Path (defaults to finsight.db inside backend directory)
FINSIGHT_DB_PATH=finsight.db

# Automated Statement Data Purge (true / false)
# When enabled, statements older than FINSIGHT_AUTO_PURGE_HOURS are automatically deleted
FINSIGHT_AUTO_PURGE=false
FINSIGHT_AUTO_PURGE_HOURS=24

# Frontend API Base URL (defaults to http://localhost:8000)
VITE_API_BASE_URL=http://localhost:8000
